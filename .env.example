# --- Database (Postgres 13+; Neon / Supabase / Vercel Postgres all work) ---
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Auth ---
# 32+ random characters. Generate: openssl rand -base64 48
AUTH_SECRET=
# Comma-separated mobile numbers that become admins on login, e.g. 9876543210,9123456789
ADMIN_PHONES=

# --- OTP delivery ---
# mock  = OTP is only written to the server log (safe default, no SMS sent)
# msg91 = real SMS via MSG91 (needs the two vars below)
OTP_PROVIDER=mock
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# NEVER set this to 1 on the live site: it shows the OTP on screen, so anyone could log in as anyone (including admins).
# OTP_DEBUG_SHOW=0

# Payments (Razorpay). Without keys: local/dev uses a test mode that charges nothing;
# production shows "online payments not available". Set PAYMENT_MOCK=1 only for demos.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Shipping (flat until Shiprocket rates are wired in)
SHIPPING_FEE=49
FREE_SHIPPING_ABOVE=499
