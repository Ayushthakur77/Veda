# --- Database (Postgres 13+; Neon / Supabase / Vercel Postgres all work) ---
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Auth ---
# 32+ random characters. Generate: openssl rand -base64 48
AUTH_SECRET=
# Comma-separated mobile numbers that become admins on login, e.g. 9876543210,9123456789
ADMIN_PHONES=

# --- OTP delivery ---
# mock  = OTP is only written to the server log (safe default, no SMS sent)
# msg91 = real SMS via MSG91 (needs the two vars below)
OTP_PROVIDER=mock
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# NEVER set this to 1 on the live site: it shows the OTP on screen, so anyone could log in as anyone (including admins).
# OTP_DEBUG_SHOW=0

# Payments (Razorpay). Without keys: local/dev uses a test mode that charges nothing;
# production shows "online payments not available". Set PAYMENT_MOCK=1 only for demos.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Shipping (flat until Shiprocket rates are wired in)
SHIPPING_FEE=49
FREE_SHIPPING_ABOVE=499

# --- Google sign-in (optional) ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web). Add your site URL under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=
# Comma-separated Google e-mails that become admins on sign-in
ADMIN_EMAILS=

# Shiprocket (admin > order > "Ship via Shiprocket")
# Create an API user in Shiprocket panel: Settings > API > Create API User (use a separate email, not your login email)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
# Package defaults
PKG_WEIGHT_KG=0.5
PKG_LENGTH_CM=15
PKG_BREADTH_CM=12
PKG_HEIGHT_CM=8

# Cash on Delivery (default on). Set COD_ENABLED=0 to switch off.
COD_ENABLED=1
COD_MAX_ORDER=5000

# --- Shadowfax courier (see README "Courier") ---
SHADOWFAX_TOKEN=            # production token from Shadowfax dashboard (never commit / paste in chat)
SHADOWFAX_ENV=production    # staging | production
SHADOWFAX_WEBHOOK_KEY=      # secret also set in Shadowfax callback settings -> /api/webhooks/shadowfax
# Pickup for Veda-owned products (marketplace sellers use their own premises address)
COMPANY_PICKUP_NAME=
COMPANY_PHONE=
COMPANY_ADDRESS=
COMPANY_CITY=
COMPANY_STATE=Delhi
COMPANY_PINCODE=
PKG_WEIGHT_GRAMS=500
